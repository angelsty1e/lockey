# --- Server ---
HOST=127.0.0.1                # 0.0.0.0 si reverse-proxy externe sur autre host
PORT=3000
NODE_ENV=production
TRUST_PROXY=loopback          # 1 si derrière nginx externe (1 hop)

# --- Database (PostgreSQL local recommandé) ---
DATABASE_URL="postgresql://lockey_user:CHANGE_ME@localhost:5432/lockey?schema=public"

# --- Auth ---
# Toutes les clés ci-dessous DOIVENT être générées aléatoirement :
#   openssl rand -base64 48
# Le serveur REFUSE de démarrer si une clé contient « CHANGE_ME » ou a une
# entropie triviale (< 12 caractères distincts).
JWT_SECRET=CHANGE_ME_run_openssl_rand_base64_48
JWT_EXPIRES_IN=12h

# Clé HMAC du chaînage du journal d'audit (intégrité forensique). Détenue hors
# base : c'est ce qui empêche un porteur d'accès DB de recalculer la chaîne.
# Optionnelle (à défaut dérivée de JWT_SECRET), mais une clé dédiée est
# préférable pour découpler la rotation de session de l'audit.
AUDIT_HMAC_KEY=CHANGE_ME_run_openssl_rand_base64_48

# Chiffre les secrets 2FA (TOTP) au repos. OBLIGATOIRE dès qu'un utilisateur
# active le 2FA (le serveur refuse de booter sinon).
VAULT_MASTER_KEY=CHANGE_ME_run_openssl_rand_base64_48

# Chiffre le mot de passe SMTP au repos. OBLIGATOIRE pour enregistrer un mot de
# passe SMTP (l'écriture échoue sans cette clé — plus de fallback JWT_SECRET).
SMTP_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_base64_48

# --- Logs ---
LOG_LEVEL=info

# --- CORS (optionnel : laisser vide en prod si nginx en front) ---
CORS_ORIGIN=
